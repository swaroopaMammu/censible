<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/dp_27"
    android:background="@color/text_white"
    tools:context=".view.MainCategoryDetailScreen">
    <TextView
        android:id="@+id/category_title"
        style="@style/CustomTitleTextLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Essentials detail"
        android:textColor="@color/title_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/budget_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/grey_border_box_bgd"
        android:text="Set Budget"
        android:visibility="visible"
        android:paddingVertical="@dimen/dp_10"
        android:paddingHorizontal="@dimen/dp_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subCategory"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/budget_button"
            app:layout_constraintEnd_toStartOf="@+id/radio_bills" />

    <androidx.cardview.widget.CardView
        android:id="@+id/main_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/dp_10"
        app:cardElevation="@dimen/dp_5"
        android:layout_marginHorizontal="@dimen/dp_5"
        app:layout_constraintTop_toBottomOf="@+id/subCategory"
        android:layout_marginTop="@dimen/dp_10">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_margin="@dimen/dp_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/spend_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/CustomTitleTextSmall"
                android:text="Total Spend"/>
            <TextView
                android:id="@+id/spend_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/CustomTitleTextSmall"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="₹260"/>
            <TextView
                android:id="@+id/budget_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/dp_5"
                app:layout_constraintTop_toBottomOf="@+id/spend_text"
                style="@style/CustomTitleTextSmall"
                android:text="Budget limit"/>
            <TextView
                android:id="@+id/budget_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/spend_value"
                style="@style/CustomTitleTextSmall"
                android:layout_marginTop="@dimen/dp_5"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="₹5000"/>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:progress="40"
                app:layout_constraintTop_toBottomOf="@+id/budget_text"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <TextView
        android:id="@+id/date_filter"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_card"
        android:background="@drawable/grey_border_box_bgd"
        android:padding="@dimen/dp_10"
        android:textSize="@dimen/sp_14"
        android:drawableEnd="@drawable/baseline_arrow_drop_down"
        android:layout_marginTop="@dimen/dp_20"
        />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/viewPager"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_0"
        android:orientation="vertical"
        android:layout_marginVertical="@dimen/dp_5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/date_filter"
        app:layout_constraintBottom_toTopOf="@+id/add_new_exp_button"/>
    <Button
        android:id="@+id/add_new_exp_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/new_expense_title"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>